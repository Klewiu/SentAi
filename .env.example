DJANGO_SETTINGS_MODULE=sentai.settings.dev
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_LANGUAGE_CODE=en
DJANGO_TIME_ZONE=Europe/Warsaw
SITE_BASE_URL=http://127.0.0.1:8000

# Stripe (test mode)
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=pln
MANUAL_PRO_PRICE_PLN=48000
MANUAL_PRO_PRICE_EUR=11200
MANUAL_PAYMENT_RECIPIENT=XOAILA DEMO SP. Z O.O.
MANUAL_PAYMENT_IBAN_PLN=PL00 0000 0000 0000 0000 0000 0000
MANUAL_PAYMENT_IBAN_EUR=PL00 0000 0000 0000 0000 0000 0001
MANUAL_PAYMENT_BANK=Demo Bank S.A.

# Use sqlite locally by default. Switch to postgres in production.
DB_ENGINE=sqlite
DB_NAME=sentai
DB_USER=sentai
DB_PASSWORD=sentai
DB_HOST=localhost
DB_PORT=5432

# Local email uses the console. Production must use a working delivery backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com
ADMIN_MFA_REQUIRED=True
# Temporary registration setting: enable after configuring email delivery.
REGISTRATION_EMAIL_VERIFICATION_REQUIRED=False
AUTH_RATE_LIMIT=30
# Enable only after verifying the production proxy/domain configuration.
DJANGO_TRUST_PROXY=False
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False


# Google Identity Services web client ID (no client secret required).
GOOGLE_CLIENT_ID=
